{
  "cleanUrls": true,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(kenney_pirate-kit/.*|.*\\.(?:glb|gltf|bin|jpg|jpeg|png|webp|svg|ico|mp3|wav|ogg|woff2?|ttf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
